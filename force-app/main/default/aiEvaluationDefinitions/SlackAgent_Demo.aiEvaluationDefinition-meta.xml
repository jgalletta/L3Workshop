<?xml version="1.0" encoding="UTF-8"?>
<AiEvaluationDefinition xmlns="http://soap.sforce.com/2006/04/metadata">
    <name>SlackAgent_Demo</name>
    <subjectName>SlackAgent</subjectName>
    <subjectType>AGENT</subjectType>
    <testCase>
        <expectation>
            <expectedValue>case_lookup</expectedValue>
            <name>topic_sequence_match</name>
        </expectation>
        <expectation>
            <expectedValue>[&apos;get_case&apos;]</expectedValue>
            <name>action_sequence_match</name>
        </expectation>
        <expectation>
            <expectedValue>Agent retrieves the case and reports its details, such as the subject, status, and priority.</expectedValue>
            <name>bot_response_rating</name>
        </expectation>
        <inputs>
            <utterance>Can you look up case 00001074?</utterance>
        </inputs>
        <number>1</number>
    </testCase>
    <testCase>
        <expectation>
            <name>topic_sequence_match</name>
        </expectation>
        <expectation>
            <expectedValue>[]</expectedValue>
            <name>action_sequence_match</name>
        </expectation>
        <expectation>
            <expectedValue>Agent politely declines the off-topic request and redirects the user to case or support related help.</expectedValue>
            <name>bot_response_rating</name>
        </expectation>
        <inputs>
            <utterance>What&apos;s the weather in Paris today?</utterance>
        </inputs>
        <number>2</number>
    </testCase>
    <testCase>
        <expectation>
            <expectedValue>escalation</expectedValue>
            <name>topic_sequence_match</name>
        </expectation>
        <expectation>
            <expectedValue>[]</expectedValue>
            <name>action_sequence_match</name>
        </expectation>
        <expectation>
            <expectedValue>Agent moves to escalate the conversation to a live human agent.</expectedValue>
            <name>bot_response_rating</name>
        </expectation>
        <inputs>
            <utterance>I want to talk to a human agent.</utterance>
        </inputs>
        <number>3</number>
    </testCase>
</AiEvaluationDefinition>
