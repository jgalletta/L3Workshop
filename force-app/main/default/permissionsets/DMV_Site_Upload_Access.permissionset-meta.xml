<?xml version="1.0" encoding="UTF-8"?>
<PermissionSet xmlns="http://soap.sforce.com/2006/04/metadata">
    <description>Grants the DMV Portal site user access to the on-page document upload component: the controller, the Application object, and the fields the upload flow writes.</description>
    <hasActivationRequired>false</hasActivationRequired>
    <label>DMV Site Upload Access</label>
    <classAccesses>
        <apexClass>DLPageUploadController</apexClass>
        <enabled>true</enabled>
    </classAccesses>
    <fieldPermissions>
        <editable>true</editable><field>Application__c.Contact__c</field><readable>true</readable>
    </fieldPermissions>
    <fieldPermissions>
        <editable>true</editable><field>Application__c.Status__c</field><readable>true</readable>
    </fieldPermissions>
    <objectPermissions>
        <allowCreate>true</allowCreate>
        <allowDelete>false</allowDelete>
        <allowEdit>true</allowEdit>
        <allowRead>true</allowRead>
        <modifyAllRecords>false</modifyAllRecords>
        <object>Application__c</object>
        <viewAllRecords>false</viewAllRecords>
    </objectPermissions>
</PermissionSet>
